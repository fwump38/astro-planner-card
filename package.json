{
  "name": "astro-planner-card",
  "version": "0.8.0",
  "description": "Home Assistant Lovelace card: clear-sky charts, dark-site ranking, Milky Way calendar and a Messier/planet target list built on AstroWeather.",
  "type": "module",
  "main": "dist/astro-planner-card.js",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c --watch",
    "dev": "rollup -c --watch --environment DEV",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "node dev/serve.mjs"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "hacs",
    "astrophotography",
    "milky-way",
    "messier",
    "astro-planner",
    "astroweather"
  ],
  "license": "MIT",
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-replace": "6.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "rollup": "4.64.5",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
